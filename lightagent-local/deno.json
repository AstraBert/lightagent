    "dev": "deno run --allow-net --allow-env --allow-ffi --allow-read --allow-run --allow-write src/main.ts",
    "build": "deno compile -A -o lightagent-cli src/main.ts"
  },
  "imports": {
    "@db/sqlite": "jsr:@db/sqlite@^0.13.0",
    "@std/assert": "jsr:@std/assert@1",
    "@std/cli": "jsr:@std/cli@^1.0.32"
  },
  "compile": {
    "include": [
      "../lightagent-core/src/migrations"
    ]
  }
}
